+#define CJK_GLYPH 0x8000
+
 static inline u16 GlyphBits(const Font *font, u16 glyph, int row, int half)
 {
+    if (glyph & CJK_GLYPH)
+        return Cjk_GlyphBits(glyph & 0x7FFF, row, half);
