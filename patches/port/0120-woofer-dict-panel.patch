+/* ------------------------------------------------------------------------ */
+/* Chinese build: the dictionary panel                                      */
+/* ------------------------------------------------------------------------ */
+
+/*
+ * While a field message with words (zh_gloss.bin) is up, the whole bottom
+ * screen shows its page: the words to tap, the tapped word with pinyin,
+ * meaning and HSK level, and SAVE and ENGLISH. The data is woofer_dict.c's.
+ */
+#define DICT_X0 10
+#define DICT_X1 (W - 10)
+#define DICT_TEXT_Y 12
+#define DICT_TEXT_Y1 132
+#define DICT_INFO_Y 144
+#define DICT_BUTTON_Y 204
+#define DICT_BUTTON_H 28
+#define DICT_BUTTON_W 140
+
+typedef struct
+{
+    s16 x, y, w, h;
+} DictHit;
+
+static DictHit sDictHits[96];
+
+/*
+ * What the player points at on the bottom screen, for the Woofer panel
+ * (WooferDict_OnFocus): the move under the cursor in a battle's move menu,
+ * the item in the bag, the move chosen in the summary, the mon in the
+ * Pokédex. NULL when nothing there has words.
+ */
+static const u8 *DictFocusText(const ViewState *s)
+{
+    if (s->mode == MODE_BATTLE_MOVE)
+    {
+        if (s->cursor < MAX_MON_MOVES && s->moves4.moves[s->cursor] != MOVE_NONE
+         && s->moves4.moves[s->cursor] < MOVES_COUNT)
+            return gMoveNames[s->moves4.moves[s->cursor]];
+        return NULL;
+    }
+    switch (s->native)
+    {
+    case NATIVE_BAG:
+        if ((s->bv.state == CTR_BAG_VIEW_LIST || s->bv.state == CTR_BAG_VIEW_ACTIONS)
+         && s->bv.cursor < s->bv.numRows && s->bv.cursor < CTR_BAG_ROWS && s->bv.items[s->bv.cursor] != ITEM_NONE)
+            return ItemId_GetName(s->bv.items[s->bv.cursor]);
+        break;
+    case NATIVE_SUMMARY:
+        if (s->sv.movesMode != CTR_SUM_MOVES_VIEW && s->sv.firstMove < 5 && s->sv.moves[s->sv.firstMove] != MOVE_NONE
+         && s->sv.moves[s->sv.firstMove] < MOVES_COUNT)
+            return gMoveNames[s->sv.moves[s->sv.firstMove]];
+        break;
+    case NATIVE_DEX:
+        if ((s->dx.state == CTR_DEX_VIEW_LIST || s->dx.state == CTR_DEX_VIEW_INFO) && s->dx.species != SPECIES_NONE
+         && s->dx.species < NUM_SPECIES)
+            return gSpeciesNames[s->dx.species];
+        break;
+    }
+    return NULL;
+}
+static u8 sDictHitCount;
+
+static u16 DictColour(u8 r, u8 g, u8 b)
+{
+    return Rgb565((u16)(r | (g << 5) | (b << 10)));
+}
+
+/* A tone mark over the letter drawn at x (its advance w), y the glyph's top. */
+static void DrawToneMark(int x, int w, int y, u8 tone, u16 c)
+{
+    int cx = x + (w - 1) / 2;
+
+    switch (tone)
+    {
+    case 1:
+        for (int i = -2; i <= 1; ++i)
+            Put(cx + i, y + 3, c);
+        break;
+    case 2:
+        Put(cx + 1, y + 1, c);
+        Put(cx, y + 2, c);
+        Put(cx - 1, y + 3, c);
+        break;
+    case 3:
+        Put(cx - 2, y + 1, c);
+        Put(cx - 1, y + 2, c);
+        Put(cx, y + 3, c);
+        Put(cx + 1, y + 2, c);
+        Put(cx + 2, y + 1, c);
+        break;
+    case 4:
+        Put(cx - 1, y + 1, c);
+        Put(cx, y + 2, c);
+        Put(cx + 1, y + 3, c);
+        break;
+    }
+}
+
+/* Pinyin as the game's letters with the tones drawn over them; returns x. */
+static int DrawPinyin(const WooferWord *w, int x, int y, u16 fg, u16 shadow)
+{
+    if (!w->pGame)
+        return x;
+    for (int i = 0; w->pGame[i] != EOS; ++i)
+    {
+        int adv = DrawGlyph(&sNormal, w->pGame[i], x, y, fg, shadow);
+
+        DrawToneMark(x, adv, y, w->pTones[i], fg);
+        x += adv;
+    }
+    return x;
+}
+
+/* Game text wrapped at spaces between x0 and x1, from y. */
+static void DrawWrapped(const Font *font, const u8 *str, int x0, int x1, int y, int y1, u16 fg, u16 shadow)
+{
+    u8 word[64];
+    int x = x0, lh = font->lineHeight + 2;
+
+    while (*str != EOS && y + font->height <= y1)
+    {
+        int n = 0, w;
+
+        while (*str == CHAR_SPACE)
+            ++str;
+        while (*str != EOS && *str != CHAR_SPACE && n < (int)sizeof(word) - 1)
+            word[n++] = *str++;
+        word[n] = EOS;
+        if (!n)
+            break;
+        w = StrWidth(font, word);
+        if (x > x0 && x + w > x1)
+        {
+            x = x0;
+            y += lh;
+            if (y + font->height > y1)
+                break;
+        }
+        DrawStr(font, word, x, y, fg, shadow);
+        x += w + font->widths[CHAR_SPACE];
+    }
+}
+
+static void DrawDictButton(int x, const u8 *label, bool8 lit)
+{
+    u16 face = lit ? DictColour(8, 16, 12) : DictColour(6, 9, 14);
+
+    FillRect(x, DICT_BUTTON_Y, DICT_BUTTON_W, DICT_BUTTON_H, DictColour(18, 20, 24));
+    FillRect(x + 1, DICT_BUTTON_Y + 1, DICT_BUTTON_W - 2, DICT_BUTTON_H - 2, face);
+    DrawStr(&sNormal, label, x + (DICT_BUTTON_W - StrWidth(&sNormal, label)) / 2,
+            DICT_BUTTON_Y + (DICT_BUTTON_H - sNormal.height) / 2 + 1, DictColour(31, 31, 31), DictColour(2, 3, 6));
+}
+
+static void DrawDictPanel(void)
+{
+    u16 bg = DictColour(3, 4, 8), fg = DictColour(31, 31, 31), shadow = DictColour(1, 1, 3);
+    u16 accent = DictColour(31, 24, 8), soft = DictColour(18, 20, 24), mark = DictColour(8, 12, 22);
+    int x = DICT_X0, y = DICT_TEXT_Y, lh = sNormal.lineHeight + 6, n = WooferDict_SegCount();
+    int selected = WooferDict_Selected();
+    WooferWord word;
+
+    FillRect(0, 0, W, H, bg);
+    sDictHitCount = 0;
+    if (WooferDict_ShowsEnglish())
+        DrawWrapped(&sNormal, WooferDict_EnglishPage(), DICT_X0, DICT_X1, y, DICT_TEXT_Y1, soft, shadow);
+    else for (int i = 0; i < n && i < (int)ARRAY_COUNT(sDictHits); ++i)
+    {
+        int isWord = 0, w;
+        const u8 *text = WooferDict_Seg(i, &isWord);
+
+        if (!text)
+            continue;
+        w = StrWidth(&sNormal, text);
+        if (x > DICT_X0 && x + w > DICT_X1)
+        {
+            x = DICT_X0;
+            y += lh;
+        }
+        if (y + sNormal.height > DICT_TEXT_Y1)
+            break;
+        if (i == selected)
+            FillRect(x - 1, y - 1, w + 2, sNormal.height + 2, mark);
+        DrawStr(&sNormal, text, x, y, i == selected ? accent : fg, shadow);
+        if (isWord)
+            FillRect(x, y + sNormal.height + 1, w - 1, 1, i == selected ? accent : soft);
+        sDictHits[i].x = x;
+        sDictHits[i].y = y - 3;
+        sDictHits[i].w = w;
+        sDictHits[i].h = lh;
+        sDictHitCount = i + 1;
+        x += w;
+    }
+    FillRect(DICT_X0, DICT_INFO_Y - 6, DICT_X1 - DICT_X0, 1, soft);
+    if (WooferDict_SelectedWord(&word))
+    {
+        int px = DrawStr(&sNormal, word.game, DICT_X0, DICT_INFO_Y, accent, shadow) + 10;
+
+        DrawPinyin(&word, px, DICT_INFO_Y, fg, shadow);
+        if (word.hsk)
+        {
+            u8 hsk[16];
+
+            memcpy(hsk, Ascii("HSK "), 5);
+            hsk[4] = CHAR_0 + (word.hsk > 6 ? 7 : word.hsk);
+            hsk[5] = EOS;
+            DrawStrRight(&sNormal, hsk, DICT_X1, DICT_INFO_Y, soft, shadow);
+        }
+        if (word.gGame)
+            DrawWrapped(&sNormal, word.gGame, DICT_X0, DICT_X1, DICT_INFO_Y + lh, DICT_BUTTON_Y - 4, fg, shadow);
+    }
+    else
+        DrawStr(&sNormal, Ascii("Tap a word."), DICT_X0, DICT_INFO_Y + 8, soft, shadow);
+    DrawDictButton(DICT_X0, Ascii(WooferDict_SelectedIsSaved() ? "SAVED" : "SAVE"), WooferDict_SelectedIsSaved());
+    DrawDictButton(DICT_X1 - DICT_BUTTON_W, Ascii(WooferDict_ShowsEnglish() ? "CHINESE" : "ENGLISH"), FALSE);
+}
+
+static void DictTouch(int x, int y)
+{
+    if (y >= DICT_BUTTON_Y && y < DICT_BUTTON_Y + DICT_BUTTON_H)
+    {
+        if (x >= DICT_X0 && x < DICT_X0 + DICT_BUTTON_W)
+            WooferDict_Save();
+        else if (x >= DICT_X1 - DICT_BUTTON_W && x < DICT_X1)
+            WooferDict_ToggleEnglish();
+        return;
+    }
+    if (WooferDict_ShowsEnglish())
+        return;
+    for (int i = 0; i < sDictHitCount; ++i)
+    {
+        const DictHit *h = &sDictHits[i];
+
+        if (x >= h->x - 2 && x < h->x + h->w + 2 && y >= h->y && y < h->y + h->h)
+        {
+            WooferDict_Select(i);
+            return;
+        }
+    }
+}
