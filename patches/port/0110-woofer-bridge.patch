diff --git a/3ds_port/Makefile b/3ds_port/Makefile
--- a/3ds_port/Makefile
+++ b/3ds_port/Makefile
@@ -61,6 +61,8 @@ SOURCES += src/3ds_encounters.c
 # The part of the overworld on screen, for the map objects.
 SOURCES += src/3ds_field_view.c
 SOURCES += src/3ds_cjk.c src/3ds_cjk_font.c
+# Woofer bridge to WooferCitra (docs/woofer-bridge/PROTOCOL.md).
+SOURCES += src/woofer_bridge.c
 LIBS := -lcitro2d -lcitro3d $(LIBS)
 OBJECTS := $(patsubst src/%.c,build/%.o,$(SOURCES))
 GAMEFLAGS := -DPORTABLE -DPLATFORM_3DS -D__3DS__ -DMODERN=1 -DUBFIX -D__INTELLISENSE__
diff --git a/3ds_port/src/main_3ds.c b/3ds_port/src/main_3ds.c
--- a/3ds_port/src/main_3ds.c
+++ b/3ds_port/src/main_3ds.c
@@ -91,6 +91,14 @@ int main(void)
         extern void Cjk_Init(void);
         Cjk_Init();
     }
+    {
+        /* Woofer bridge: handshake with WooferCitra and "hello" (woofer_bridge.c).
+         * On a real 3DS or in another emulator this does nothing. */
+        extern int Woofer_Init(const char *game, const char *title, const char *lang,
+                               const char *src, const char *build);
+        extern const char gCtrBuildVersion[];
+        Woofer_Init("pokeemerald-zh", "PokemonWoofer", "zh-Hans", "en", gCtrBuildVersion);
+    }
     CtrPlatformHooks hooks = {0};
     hooks.vblank = CtrGame_VBlank;
     hooks.videoPresent = CtrVideo_Present;
