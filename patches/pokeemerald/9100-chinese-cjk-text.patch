 }
 #endif
 
+
+#ifdef PORT_BRIDGE
+static inline u32 CjkPixel(const u16 *rows, s32 x, s32 y)
+{
+    if (x < 0 || x >= 12 || y < 0 || y >= 12)
+        return 0;
+    return (rows[y] >> (11 - x)) & 1;
+}
+
+static void DecompressGlyph_Cjk(u8 lead, u8 trail)
+{
+    static const u16 sBlankRows[12] = {0};
+    u32 index = gCjkLeadIndex[lead] * CJK_TRAILS + (u32)(trail - CJK_TRAIL_MIN);
+    const u16 *rows = (trail >= CJK_TRAIL_MIN && index < gCjkGlyphCount) ? gCjkGlyphs[index] : sBlankRows;
+    s32 x, y;
+
+    for (y = 0; y < 16; y++)
+    {
+        u32 words[2] = {0, 0};
+        for (x = 0; x < 16; x++)
+        {
+            u32 color;
+            if (CjkPixel(rows, x, y))
+                color = sLastTextFgColor;
+            else if (CjkPixel(rows, x - 1, y) || CjkPixel(rows, x, y - 1) || CjkPixel(rows, x - 1, y - 1))
+                color = sLastTextShadowColor;
+            else
+                color = sLastTextBgColor;
+            words[x / 8] |= (color & 0xF) << ((x % 8) * 4);
+        }
+        if (y < 8)
+        {
+            gCurGlyph.gfxBufferTop[y] = words[0];
+            gCurGlyph.gfxBufferTop[8 + y] = words[1];
+        }
+        else
+        {
+            gCurGlyph.gfxBufferBottom[y - 8] = words[0];
+            gCurGlyph.gfxBufferBottom[8 + y - 8] = words[1];
+        }
+    }
+    gCurGlyph.width = CJK_ADVANCE;
+    gCurGlyph.height = 15;
+}
+#endif
