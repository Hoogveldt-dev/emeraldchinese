+#ifdef PORT_BRIDGE
+// Chinese build: two-byte CJK characters (lead byte, trail byte), drawn from
+// a 12-px bitmap font compiled into the port (3ds_cjk_font.c).
+extern const unsigned char gCjkLeadIndex[256];
+extern const unsigned short gCjkGlyphs[][12];
+extern const unsigned int gCjkGlyphCount;
+#define CJK_TRAIL_MIN 1
+#define CJK_TRAILS 246
+#define CJK_ADVANCE 12
+#define IS_CJK_LEAD(c) (gCjkLeadIndex[(u8)(c)] != 0xFF)
+static void DecompressGlyph_Cjk(u8 lead, u8 trail);
+#endif
